# Local development only. Copy this file to .env before starting Docker.
POSTGRES_PASSWORD=chat_local_dev
PORT=9090
# Fill all four values from Pusher Channels > App Keys to enable realtime.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:9090
DATABASE_URL=postgres://chat:chat_local_dev@localhost:5432/chat?sslmode=disable
# Email codes use Gmail SMTP. Enable 2-Step Verification, create an App Password,
# and enter that password here (never use your normal Google account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SITE_URL=http://localhost:3000
